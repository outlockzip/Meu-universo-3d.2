<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>Universe Explorer 3D</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#02040d;color:#eafaff;font-family:system-ui,sans-serif}canvas{display:block;position:fixed;inset:0}#hud{position:fixed;inset:0;pointer-events:none;z-index:2}.panel{background:#061327cc;border:1px solid #66eaff66;backdrop-filter:blur(9px);border-radius:13px;padding:11px 13px}#brand{position:absolute;left:10px;top:10px}#brand b{font-size:12px;letter-spacing:.12em;color:#72f6ff}#status{font-size:11px;margin-top:4px}#mission{position:absolute;right:10px;top:10px;width:min(220px,48vw);font-size:11px;line-height:1.5}#mission strong{display:block;color:#72f6ff}#message{position:absolute;top:22%;left:50%;transform:translateX(-50%);text-align:center;width:90%;text-shadow:0 2px 10px #000}#prompt{font-weight:800;color:#72f6ff;font-size:clamp(14px,3vw,21px)}#subprompt{font-size:12px;margin-top:5px}#bottom{position:absolute;bottom:10px;left:0;width:100%;text-align:center;font-size:11px;color:#c5d9f2}#action{display:none;pointer-events:auto;padding:12px 16px;margin-bottom:8px;border:1px solid #72f6ff;border-radius:12px;background:#07334b;color:white;font-weight:800}.pad{pointer-events:auto;position:absolute;bottom:65px;display:grid;grid-template-columns:repeat(3,45px);gap:5px}.pad.left{left:10px}.pad.right{right:10px;grid-template-columns:repeat(2,45px)}.pad button{height:43px;border:1px solid #72f6ff77;border-radius:10px;background:#07172ddd;color:white;font-weight:bold;touch-action:none}.pad .wide{grid-column:span 2}#loading{position:fixed;inset:0;display:grid;place-items:center;background:#02040d;color:#72f6ff;z-index:9;transition:opacity .5s}#loading.hide{opacity:0;pointer-events:none}@media(min-width:800px){.pad{opacity:.5}}
</style>
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/"}}</script></head>
<body><div id="loading">INICIALIZANDO UNIVERSO…</div><div id="hud">
<div id="brand" class="panel"><b>UNIVERSE EXPLORER 3D</b><div id="status">Modo espacial · Nave ativa</div></div>
<div id="mission" class="panel"><strong id="modeTitle">MISSÃO: EXPLORAÇÃO</strong><span id="missionText">Aproxime-se de um planeta para pousar.</span><br><span id="coords"></span></div>
<div id="message"><div id="prompt">UNIVERSE EXPLORER 3D</div><div id="subprompt">Voe pelo espaço e visite os planetas.</div></div>
<div id="bottom"><button id="action">POUSAR</button><div id="help">PC: WASD mover · Espaço/Ctrl subir/descer · Shift acelerar · E pousar · Esc voltar</div></div>
<div class="pad left"><button data-key="KeyW" style="grid-column:2">▲</button><button data-key="KeyA">◀</button><button data-key="KeyS">▼</button><button data-key="KeyD">▶</button></div>
<div class="pad right"><button data-key="Space">↑</button><button data-key="ControlLeft">↓</button><button data-key="ShiftLeft" class="wide">ACELERAR</button></div></div>
<script type="module">
import * as THREE from 'three';
import {OrbitControls} from 'three/addons/controls/OrbitControls.js';
const $=id=>document.getElementById(id),scene=new THREE.Scene();scene.background=new THREE.Color(0x02040d);
const camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,20000);camera.position.set(0,40,100);
const renderer=new THREE.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,1.6));renderer.setSize(innerWidth,innerHeight);renderer.outputColorSpace=THREE.SRGBColorSpace;document.body.prepend(renderer.domElement);
scene.add(new THREE.AmbientLight(0x8aa7d9,1.5));const light=new THREE.PointLight(0xffffff,2200,4000);scene.add(light);
const sg=new THREE.BufferGeometry(),sp=[];for(let i=0;i<5000;i++){const r=THREE.MathUtils.randFloat(400,6000),a=Math.random()*6.28,b=Math.acos(THREE.MathUtils.randFloatSpread(2));sp.push(r*Math.sin(b)*Math.cos(a),r*Math.cos(b),r*Math.sin(b)*Math.sin(a))}sg.setAttribute('position',new THREE.Float32BufferAttribute(sp,3));const stars=new THREE.Points(sg,new THREE.PointsMaterial({color:0xddeaff,size:2}));scene.add(stars);
const sun=new THREE.Mesh(new THREE.SphereGeometry(9,24,20),new THREE.MeshBasicMaterial({color:0xffb844}));scene.add(sun);light.position.copy(sun.position);
const specs=[['Mercúrio',2,20,0x9a9187,.22],['Vênus',3.6,30,0xd5a76e,.15],['Terra',4,43,0x2678ff,.10],['Marte',3,57,0xc94e35,.08],['Júpiter',8,80,0xd8b28a,.05],['Saturno',7,108,0xd9c48b,.035],['Urano',5,138,0x7adbdc,.026],['Netuno',5,165,0x4169e1,.02]];
const planets=[];for(const [name,r,d,c,speed] of specs){const ring=new THREE.Mesh(new THREE.RingGeometry(d-.06,d+.06,100),new THREE.MeshBasicMaterial({color:0x315b82,transparent:true,opacity:.4,side:THREE.DoubleSide}));ring.rotation.x=-Math.PI/2;scene.add(ring);const group=new THREE.Group();scene.add(group);const mesh=new THREE.Mesh(new THREE.SphereGeometry(r,28,20),new THREE.MeshStandardMaterial({color:c,roughness:.8}));group.add(mesh);if(name==='Saturno'){const rr=new THREE.Mesh(new THREE.RingGeometry(r*1.3,r*2,40),new THREE.MeshStandardMaterial({color:0xd7c69c,side:THREE.DoubleSide}));rr.rotation.x=1.1;mesh.add(rr)}if(name==='Terra'){mesh.add(new THREE.Mesh(new THREE.SphereGeometry(r*1.08,24,16),new THREE.MeshBasicMaterial({color:0x38aaff,transparent:true,opacity:.12,side:THREE.BackSide})))}
planets.push({name,r,d,c,speed,group,mesh,a:Math.random()*6.28})}
const ship=new THREE.Group(),hull=new THREE.Mesh(new THREE.ConeGeometry(1.1,5,8),new THREE.MeshStandardMaterial({color:0xc8d8e9,metalness:.6,roughness:.3}));hull.rotation.x=Math.PI/2;ship.add(hull);const glass=new THREE.Mesh(new THREE.SphereGeometry(.7,14,10),new THREE.MeshStandardMaterial({color:0x36d8ff,emissive:0x073e60}));glass.position.y=.4;ship.add(glass);for(const s of [-1,1]){const w=new THREE.Mesh(new THREE.BoxGeometry(2.7,.15,1.4),new THREE.MeshStandardMaterial({color:0x70849b}));w.position.set(s*1.3,0,.8);ship.add(w)}scene.add(ship);
const orbit=new OrbitControls(camera,renderer.domElement);orbit.enableDamping=true;orbit.target.copy(ship.position);orbit.maxDistance=200;
const keys=new Set();window.addEventListener('keydown',e=>{keys.add(e.code);if(e.code==='KeyE'||e.code==='Enter')interact();if(e.code==='Escape'&&mode==='surface')leave()});window.addEventListener('keyup',e=>keys.delete(e.code));
document.querySelectorAll('[data-key]').forEach(b=>{const k=b.dataset.key;b.addEventListener('pointerdown',e=>{e.preventDefault();keys.add(k)});for(const ev of ['pointerup','pointercancel','pointerleave'])b.addEventListener(ev,()=>keys.delete(k))});
let mode='space',near=null,target=null,surface=null,avatar=null,player={x:0,z:8,yaw:0},shipPos=new THREE.Vector3(0,0,12),last=performance.now();
function msg(a,b){$('prompt').textContent=a;$('subprompt').textContent=b}
function hud(){ $('status').textContent=mode==='space'?'Modo espacial · Nave ativa':`Explorando ${target.name}`;$('modeTitle').textContent=mode==='space'?'MISSÃO: EXPLORAÇÃO':'MISSÃO: SUPERFÍCIE';$('missionText').textContent=mode==='space'?'Aproxime-se de um planeta e pouse.':'Explore o terreno e volte à nave quando quiser.';$('help').textContent=mode==='space'?'PC: WASD · Espaço/Ctrl subir/descer · Shift acelerar · E pousar':'PC: WASD andar · Shift correr · E voltar à nave · Arraste/olhe ao redor'}
function land(p){mode='surface';target=p;near=null;scene.background=new THREE.Color(p.name==='Terra'?0x6ba5e5:p.name==='Marte'?0xb86d50:0x9b8a79);scene.fog=new THREE.Fog(scene.background,100,380);stars.visible=false;sun.visible=false;planets.forEach(q=>q.group.visible=false);ship.visible=false;surface=new THREE.Group();scene.add(surface);
const geo=new THREE.PlaneGeometry(420,420,70,70),a=geo.attributes.position;for(let i=0;i<a.count;i++){let x=a.getX(i),z=a.getY(i);a.setZ(i,Math.sin(x*.07)*1.2+Math.cos(z*.06)*1.5+Math.sin((x+z)*.025)*2)}geo.computeVertexNormals();const ground=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color:p.name==='Terra'?0x315c38:p.name==='Marte'?0x98432e:0x77716a,roughness:1}));ground.rotation.x=-Math.PI/2;ground.position.y=-1.5;surface.add(ground);
const sky=new THREE.Mesh(new THREE.SphereGeometry(480,20,14),new THREE.MeshBasicMaterial({color:scene.background,side:THREE.BackSide}));surface.add(sky);
for(let i=0;i<100;i++){const r=THREE.MathUtils.randFloat(.5,3.2),rock=new THREE.Mesh(new THREE.DodecahedronGeometry(r),new THREE.MeshStandardMaterial({color:p.name==='Terra'?0x49734a:0x8a7565}));rock.position.set(THREE.MathUtils.randFloatSpread(350),-.5,THREE.MathUtils.randFloatSpread(350));rock.scale.y=Math.random()+.5;surface.add(rock)}
avatar=new THREE.Group();const body=new THREE.Mesh(new THREE.CapsuleGeometry(.4,1,4,8),new THREE.MeshStandardMaterial({color:0xe5f3ff}));body.position.y=.35;avatar.add(body);const helmet=new THREE.Mesh(new THREE.SphereGeometry(.38,14,10),new THREE.MeshStandardMaterial({color:0x58dfff,metalness:.4}));helmet.position.y=1.3;avatar.add(helmet);surface.add(avatar);player={x:0,z:8,yaw:0};$('action').textContent='VOLTAR À NAVE 🚀';$('action').style.display='inline-block';msg(`BEM-VINDO(A) A ${p.name.toUpperCase()}`,'Pouso concluído! Explore o planeta.');hud()}
function leave(){mode='space';if(surface)scene.remove(surface);surface=null;stars.visible=true;sun.visible=true;planets.forEach(q=>q.group.visible=true);ship.visible=true;scene.background=new THREE.Color(0x02040d);scene.fog=null;ship.position.copy(shipPos);camera.position.set(shipPos.x,shipPos.y+15,shipPos.z+25);orbit.target.copy(shipPos);orbit.enabled=true;$('action').style.display='none';msg('DE VOLTA AO ESPAÇO','Aproxime-se de outro planeta para visitar.');hud();target=null}
function interact(){if(mode==='surface'){leave();return}if(near){land(near)}else msg('NENHUM PLANETA PRÓXIMO','Voe para perto de um planeta e tente novamente.')}
$('action').addEventListener('click',interact);
function tick(now){requestAnimationFrame(tick);const dt=Math.min((now-last)/1000,.05);last=now;planets.forEach(p=>{p.a+=p.speed*dt*.12;p.group.position.set(Math.cos(p.a)*p.d,Math.sin(p.a*.7),Math.sin(p.a)*p.d);p.mesh.rotation.y+=dt*.12});
if(mode==='space'){const speed=(keys.has('ShiftLeft')||keys.has('ShiftRight'))?95:30;let x=0,y=0,z=0;if(keys.has('KeyW')||keys.has('ArrowUp'))z-=1;if(keys.has('KeyS')||keys.has('ArrowDown'))z+=1;if(keys.has('KeyA')||keys.has('ArrowLeft'))x-=1;if(keys.has('KeyD')||keys.has('ArrowRight'))x+=1;if(keys.has('Space'))y+=1;if(keys.has('ControlLeft')||keys.has('ControlRight'))y-=1;shipPos.add(new THREE.Vector3(x,y,z).normalize().multiplyScalar(speed*dt));ship.position.copy(shipPos);if(x||z)ship.rotation.y=Math.atan2(x,z);orbit.target.lerp(ship.position,.12);let dmin=Infinity;near=null;for(const p of planets){const d=ship.position.distanceTo(p.group.position);if(d<dmin){dmin=d;near=p}}if(near&&dmin<near.r+12){$('action').style.display='inline-block';$('action').textContent=`POUSAR EM ${near.name.toUpperCase()} 🌎`;msg(`PLANETA PRÓXIMO: ${near.name.toUpperCase()}`,'Toque em pousar ou aperte E.')}else{$('action').style.display='none';msg('','Aproxime-se de um planeta para pousar.')}orbit.enabled=true;orbit.update();$('coords').textContent=`Nave: ${shipPos.x.toFixed(0)}, ${shipPos.y.toFixed(0)}, ${shipPos.z.toFixed(0)}`}
else{let f=0,s=0;if(keys.has('KeyW')||keys.has('ArrowUp'))f++;if(keys.has('KeyS')||keys.has('ArrowDown'))f--;if(keys.has('KeyA')||keys.has('ArrowLeft'))s--;if(keys.has('KeyD')||keys.has('ArrowRight'))s++;let speed=(keys.has('ShiftLeft')||keys.has('ShiftRight'))?22:10,si=Math.sin(player.yaw),co=Math.cos(player.yaw);player.x+=(s*co+f*si)*speed*dt;player.z+=(-s*si+f*co)*speed*dt;player.x=THREE.MathUtils.clamp(player.x,-190,190);player.z=THREE.MathUtils.clamp(player.z,-190,190);avatar.position.set(player.x,.1,player.z);avatar.rotation.y=player.yaw;camera.position.set(player.x+Math.sin(player.yaw)*9,5.5,player.z+Math.cos(player.yaw)*9);camera.lookAt(player.x,1.2,player.z);$('coords').textContent=`Posição: ${player.x.toFixed(0)}, ${player.z.toFixed(0)}`}
renderer.render(scene,camera)}
renderer.domElement.addEventListener('pointerdown',e=>{renderer.domElement.dataset.x=e.clientX;renderer.domElement.dataset.y=e.clientY});renderer.domElement.addEventListener('pointermove',e=>{if(mode==='surface'&&e.buttons){player.yaw-=(e.clientX-Number(renderer.domElement.dataset.x||e.clientX))*.006;renderer.domElement.dataset.x=e.clientX;renderer.domElement.dataset.y=e.clientY}});
window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);renderer.setPixelRatio(Math.min(devicePixelRatio,1.6))});
hud();requestAnimationFrame(tick);setTimeout(()=>$('loading').classList.add('hide'),1000);
</script></body></html>
